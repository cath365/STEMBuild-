# PostgreSQL / Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stembuild"

# Optional private Vercel Blob storage for student evidence.
# On Vercel, prefer project-linked OIDC authentication; local development may use a token.
BLOB_READ_WRITE_TOKEN=""

# Used only for demo bootstrap scripts. Change before seeding outside local development.
DEMO_ADMIN_PASSWORD="ChangeMe-Admin-2026!"
DEMO_TEACHER_PASSWORD="ChangeMe-Teacher-2026!"
DEMO_STUDENT_PASSWORD="ChangeMe-Student-2026!"

# STEMBuild AI Lab Coach via Vercel AI Gateway. On Vercel, OIDC can authenticate automatically.
# For local/non-Vercel use, set AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=""
AI_COACH_MODEL="openai/gpt-6-luna"
